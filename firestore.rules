rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isStaff() {
      return isSignedIn() && userData(request.auth.uid).role in ['tecnico', 'admin'];
    }

    function isAdmin() {
      return isSignedIn() && userData(request.auth.uid).role == 'admin';
    }

    function isTicketOwner(ticketId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      allow create: if isSignedIn()
        && (
          (request.auth.uid == userId && request.resource.data.role == 'colaborador')
          || isAdmin()
        );

      allow update: if isAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.role == resource.data.role
        );

      allow delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if isStaff() || resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Aberto';

      allow update: if isStaff()
        || (
          resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == resource.data.status
        );

      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if isStaff() || isTicketOwner(ticketId);

        allow create: if isStaff() || isTicketOwner(ticketId);

        allow update, delete: if isAdmin();
      }
    }
  }
}
